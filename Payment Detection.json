        "formTitle": "Mark Invoice as Paid",
        "formDescription": "Manually record a payment to stop reminders for an invoice.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Invoice ID",
              "requiredField": true
            },
            {
              "fieldLabel": "Note"
            }
          ]
