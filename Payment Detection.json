    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\nconst body = j.body || {};\nlet invoice_id = \"\";\nlet source = \"Manual\";\nlet detail = \"\";\n// Manual form field\nif (j['Invoice ID']) {\n  invoice_id = j['Invoice ID'];\n  source = \"Manual\";\n  detail = j['Note'] || 'Manual override';\n} else {\n  source = \"System\";\n  // Common gateway shapes\n  if (body.invoice_id) {\n    invoice_id = body.invoice_id;\n  } else if (body.data && body.data.object && body.data.object.metadata && body.data.object.metadata.invoice_id) {\n    invoice_id = body.data.object.metadata.invoice_id;\n  } else if (j.invoice_id) {\n    invoice_id = j.invoice_id;\n  }\n  detail = body.id || body.event || j.id || 'Gateway event';\n}\nreturn { invoice_id: String(invoice_id || \"\").trim(), source, detail: String(detail || \"\") };"
      },
