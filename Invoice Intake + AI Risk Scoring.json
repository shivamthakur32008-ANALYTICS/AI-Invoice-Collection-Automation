      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\nconst errors = [];\nconst invoiceId = j.invoice_id;\nconst email = j.email;\nconst amount = Number(j.amount);\nconst dueDate = j.due_date;\nif (!invoiceId || String(invoiceId).trim() === '') errors.push('Invoice ID is required');\nconst emailRe = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (!email || !emailRe.test(String(email))) errors.push('A valid email is required');\nif (isNaN(amount) || amount <= 0) errors.push('Amount must be greater than 0');\nif (!dueDate || isNaN(new Date(dueDate).getTime())) errors.push('A valid due date is required');\nreturn { ...j, is_valid: errors.length === 0, error_message: errors.join('; ') };"
      },
