    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let raw;\ntry {\n  const out = $json.output;\n  if (Array.isArray(out) && out[0] && out[0].content && out[0].content[0]) {\n    raw = out[0].content[0].text;\n  } else if (typeof $json.text === 'string') {\n    raw = $json.text;\n  }\n} catch (e) { raw = undefined; }\nlet score = 50;\nif (raw !== undefined && raw !== null) {\n  const m = String(raw).match(/\\d+/);\n  if (m) {\n    let n = parseInt(m[0], 10);\n    if (!isNaN(n)) { if (n < 0) n = 0; if (n > 100) n = 100; score = n; }\n  }\n}\nreturn { risk_score: score };"
      },
